{
  "name": "@optolith/database-schema",
  "version": "0.90.0",
  "description": "Definitions and utilities for the flat-file database of Optolith, a character creation tool for the Pen and Paper RPG “The Dark Eye 5”, and its external integrations into other software.",
  "keywords": [
    "tde",
    "thedarkeye",
    "dsa",
    "dasschwarzeauge"
  ],
  "files": [
    "gen",
    "lib",
    "schema",
    "AUTHORS",
    "CHANGELOG.md"
  ],
  "main": "./lib/main.js",
  "exports": {
    ".": "./lib/main.js",
    "./cache": "./lib/cache/index.js",
    "./types": "./lib/types/index.js",
    "./types/*": "./lib/types/*.js",
    "./gen": "./gen/types.d.ts"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "generate": "tsondb generate",
    "generate:watch": "nodemon --watch lib --exec \"tsondb generate\" --ext js",
    "test": "node ./lib/test.js",
    "lint": "oxlint",
    "format": "oxfmt \"{src,test}/**/*.{ts,tsx}\"",
    "format:check": "oxfmt \"{src,test}/**/*.{ts,tsx}\" --check",
    "release": "commit-and-tag-version",
    "release:sign": "commit-and-tag-version --sign --signoff"
  },
  "author": "Lukas Obermann",
  "license": "MPL-2.0",
  "dependencies": {
    "@elyukai/utils": "^0.3.6",
    "tsondb": "^0.21.5"
  },
  "devDependencies": {
    "@elyukai/oxc-config": "^0.1.0",
    "@types/node": "^26.6.4",
    "commit-and-tag-version": "^13.2.1",
    "nodemon": "^3.1.14",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2"
  },
  "repository": "github:Optolith/database-schema",
  "bugs": {
    "url": "https://github.com/Optolith/database-schema/issues"
  },
  "type": "module",
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
